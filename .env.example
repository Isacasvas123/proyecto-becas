# Copiar a .env y ajustar. El archivo .env NUNCA se sube al repositorio.
#   cp .env.example .env

# --- Base de datos ---
DATABASE_URL="postgresql://becas:becas_dev@localhost:5432/becas?schema=public"

# --- API ---
PORT=3000
NODE_ENV=development

# Origen exacto del frontend al que se le permite llamar a la API (CORS).
# En Staging y produccion debe ser la URL real del frontend, nunca "*".
CORS_ORIGEN="http://localhost:5173"

# --- Autenticación ---
# En producción debe ser una cadena aleatoria larga, distinta a esta.
JWT_SECRET="cambiar-en-produccion-cadena-larga-y-aleatoria"
JWT_EXPIRACION="8h"
BCRYPT_ROUNDS=10

# --- Administrador inicial (solo para `npm run db:seed`) ---
# Credenciales del usuario administrador que crea el seed en DESARROLLO LOCAL.
#
# ⚠️  NO son credenciales de producción. Antes de desplegar a Staging hay que
#     definir otras en las variables de entorno del servidor y no reutilizar estas.
#     El seed nunca debe ejecutarse contra una base de datos real.
#
# La contraseña se almacena con hash bcrypt; el valor en claro solo vive aquí.
ADMIN_USUARIO="admin"
ADMIN_PASSWORD="EC321"
ADMIN_CORREO="admin@becas.gob.gt"

# Un SEGUNDO administrador, solo para desarrollo. La segunda aprobación de una beca de más
# de Q10,000 (US-033) debe darla una persona DISTINTA de la que dio la primera: con una sola
# cuenta ese flujo no se puede recorrer completo.
ADMIN_2_USUARIO="revisor"
ADMIN_2_PASSWORD="Revisa2026"
ADMIN_2_CORREO="revisor@becas.gob.gt"

# Evaluador de prueba (EPIC-04), mismo trato: solo para el seed local.
EVALUADOR_USUARIO="evaluadora"
EVALUADOR_PASSWORD="Evalua2026"
EVALUADOR_CORREO="evaluadora@becas.gob.gt"

# --- Almacenamiento de documentos ---
# Selecciona el adaptador (patrón Adapter, ver docs/06-patrones.md). Hoy solo existe "local";
# cualquier otro valor hace que la API no arranque, para que el error se vea al desplegar.
ALMACENAMIENTO_TIPO=local
# Relativa a apps/api/. La carpeta está en .gitignore.
ALMACENAMIENTO_RUTA_LOCAL="./uploads"
# El tamaño máximo (5 MB) y los formatos (PDF, JPG, PNG) NO se configuran aquí: son criterios de
# aceptación de US-013 y viven en el dominio (archivo-documento.vo.ts).

# --- Frontend ---
VITE_API_URL="http://localhost:3000"

# ── Correo (US-035, recuperar contraseña) ────────────────────────────────────
# "consola" escribe el mensaje en el log del servidor en lugar de enviarlo. Es el valor por
# defecto y permite recorrer el flujo entero sin un servidor SMTP: el enlace aparece en el
# log y funciona igual que si hubiera llegado al buzón.
#
# "smtp" lo envía de verdad y exige las cuatro variables de abajo.
CORREO_TIPO=consola

#SMTP_HOST="smtp.gmail.com"
#SMTP_PUERTO=465
#SMTP_USUARIO="becas@ejemplo.gt"
#SMTP_PASSWORD="la-contrasena-de-aplicacion"
#SMTP_REMITENTE="becas@ejemplo.gt"
