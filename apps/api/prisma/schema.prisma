// Esquema de persistencia — Prisma + PostgreSQL.
//
// ALCANCE ACTUAL:
//   - `Usuario` — inicio de sesión (US-002) y registro público (US-001).
//   - `Convocatoria` — con requisitos y documentos (US-006, US-007).
//   - `Estudiante` — perfil académico y socioeconómico (US-011).
//   - `Solicitud`, `DocumentoSolicitud`, `HistorialEstadoSolicitud` — EPIC-03.
//   - `Comite`, `ComiteEvaluador`, `AsignacionEvaluacion`, `Dictamen` — EPIC-04.
//
// Lo que falta (Beca) se agrega con sus historias, conforme a
// docs/05-arquitectura.md §3.3.
//
// IMPORTANTE: este esquema es el modelo de PERSISTENCIA, no el modelo de DOMINIO.
// Son parecidos hoy y no tienen por qué seguir siéndolo mañana: la traducción entre
// ambos es responsabilidad del mapper de infrastructure/. Ese costo de traducción está
// aceptado explícitamente como trade-off en docs/05-arquitectura.md §2.2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Nunca credenciales en el código: se leen de la variable de entorno (.env.example).
  url      = env("DATABASE_URL")
}

/// Roles del sistema (US-003). Solo ADMINISTRADOR se usa hoy; los demás quedan
/// declarados porque el control de acceso por rol es del Sprint 2 y este enum es la
/// referencia acordada en docs/04-product-backlog.md.
enum RolUsuario {
  ESTUDIANTE
  EVALUADOR
  ADMINISTRADOR
}

model Usuario {
  id               String     @id @default(uuid())
  nombreUsuario    String     @unique @map("nombre_usuario")
  correo           String     @unique
  // Hash bcrypt, NUNCA la contraseña en claro (NFR de seguridad,
  // docs/04-product-backlog.md §5).
  hashPassword     String     @map("hash_password")
  rol              RolUsuario @default(ESTUDIANTE)
  activo           Boolean    @default(true)
  // Bloqueo tras 5 intentos fallidos consecutivos (US-002, criterio 3). La regla vive en
  // la entidad del dominio; aquí solo se guarda el estado.
  intentosFallidos Int        @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime?  @map("bloqueado_hasta")
  // US-001. Opcionales: el administrador inicial no pasa por el registro público. `cui` es
  // único para que una persona no tenga dos cuentas; PostgreSQL admite varios NULL.
  nombreCompleto   String?    @map("nombre_completo")
  cui              String?    @unique
  creadoEn         DateTime   @default(now()) @map("creado_en")
  actualizadoEn    DateTime   @updatedAt @map("actualizado_en")

  perfilEstudiante Estudiante?
  solicitudes      Solicitud[]

  comitesCreados     Comite[]               @relation("ComiteCreadoPor")
  comites            ComiteEvaluador[]
  asignaciones       AsignacionEvaluacion[] @relation("AsignacionEvaluador")
  asignacionesHechas AsignacionEvaluacion[] @relation("AsignacionAutor")
  dictamenes         Dictamen[]

  @@map("usuarios")
}

/// Tipos de programa de beca que administra el Ministerio (US-006).
enum TipoBeca {
  NIVEL_MEDIO
  UNIVERSITARIA
  POSGRADO
}

enum Requisito {
  NACIONALIDAD_GUATEMALTECA
  ESTUDIANTE_NIVEL_MEDIO_INSCRITO
  ESTUDIANTE_UNIVERSITARIO_INSCRITO
  TITULO_UNIVERSITARIO
  PROMEDIO_MINIMO_70
  PROMEDIO_MINIMO_75
  PROMEDIO_MINIMO_80
  INGRESO_FAMILIAR_LIMITADO
  CARTA_RECOMENDACION
}

enum TipoDocumento {
  DPI
  CERTIFICADO_NACIMIENTO
  CONSTANCIA_INSCRIPCION
  CERTIFICADO_NOTAS
  TITULO_UNIVERSITARIO
  CONSTANCIA_INGRESOS
  CARTA_RECOMENDACION
}

/// Ciclo de vida de una convocatoria (US-006, US-007, US-009).
enum EstadoConvocatoria {
  BORRADOR
  PUBLICADA
  CERRADA
}

model Convocatoria {
  id                 String             @id @default(uuid())
  codigo             String             @unique
  titulo             String
  descripcion        String
  tipo               TipoBeca
  estado             EstadoConvocatoria @default(BORRADOR)
  cupos              Int
  fechaApertura      DateTime           @map("fecha_apertura")
  fechaCierre        DateTime           @map("fecha_cierre")
  // US-006. Cada tipo de beca trae los suyos por defecto (Factory Method). Listas de enums
  // de PostgreSQL: un valor fuera del catálogo lo rechaza la base, no solo la aplicación.
  requisitos         Requisito[]        @default([])
  documentosExigidos TipoDocumento[]    @default([]) @map("documentos_exigidos")
  creadaEn           DateTime           @default(now()) @map("creada_en")
  actualizadaEn      DateTime           @updatedAt @map("actualizada_en")

  solicitudes Solicitud[]
  comite      Comite?

  // El listado público filtra por estado y fecha de cierre; el NFR de rendimiento
  // exige responder en menos de 1 segundo (docs/04-product-backlog.md).
  @@index([estado, fechaCierre])
  @@map("convocatorias")
}

// ─── EPIC-02 · Perfil del estudiante (US-011) ──────────────────────────────────

enum NivelAcademico {
  NIVEL_MEDIO
  UNIVERSITARIO
  POSGRADO
}

/// Los 22 departamentos de Guatemala. Catálogo cerrado para el reporte por región (US-031).
enum Departamento {
  ALTA_VERAPAZ
  BAJA_VERAPAZ
  CHIMALTENANGO
  CHIQUIMULA
  EL_PROGRESO
  ESCUINTLA
  GUATEMALA
  HUEHUETENANGO
  IZABAL
  JALAPA
  JUTIAPA
  PETEN
  QUETZALTENANGO
  QUICHE
  RETALHULEU
  SACATEPEQUEZ
  SAN_MARCOS
  SANTA_ROSA
  SOLOLA
  SUCHITEPEQUEZ
  TOTONICAPAN
  ZACAPA
}

/// Perfil del estudiante. Uno por usuario; todos los campos opcionales porque se llena por
/// partes. Que esté completo lo decide la entidad del dominio, no la base.
model Estudiante {
  id                     String          @id @default(uuid())
  usuarioId              String          @unique @map("usuario_id")
  usuario                Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  centroEducativo        String?         @map("centro_educativo")
  nivel                  NivelAcademico?
  // Decimal exacto: un promedio de 69.995 no debe redondearse a 70 y cumplir un requisito.
  promedio               Decimal?        @db.Decimal(5, 2)
  ingresoFamiliarMensual Decimal?        @map("ingreso_familiar_mensual") @db.Decimal(12, 2)
  dependientes           Int?
  departamento           Departamento?
  municipio              String?
  creadoEn               DateTime        @default(now()) @map("creado_en")
  actualizadoEn          DateTime        @updatedAt @map("actualizado_en")

  @@map("estudiantes")
}

// ─── EPIC-03 · Solicitudes ─────────────────────────────────────────────────────

/// Ciclo de vida de una solicitud (patrón State, docs/06-patrones.md §5).
enum EstadoSolicitud {
  BORRADOR
  ENVIADA
  EN_EVALUACION
  APROBADA
  RECHAZADA
  ADJUDICADA
}

model Solicitud {
  id                 String          @id @default(uuid())
  // SOL-2026-000001
  numero             String          @unique
  estudianteId       String          @map("estudiante_id")
  estudiante         Usuario         @relation(fields: [estudianteId], references: [id], onDelete: Restrict)
  convocatoriaId     String          @map("convocatoria_id")
  convocatoria       Convocatoria    @relation(fields: [convocatoriaId], references: [id], onDelete: Restrict)
  estado             EstadoSolicitud @default(BORRADOR)
  // Foto de lo que exigía la convocatoria al crear la solicitud (ver la entidad).
  documentosExigidos String[]        @default([]) @map("documentos_exigidos")
  enviadaEn          DateTime?       @map("enviada_en")
  creadaEn           DateTime        @default(now()) @map("creada_en")
  actualizadaEn      DateTime        @updatedAt @map("actualizada_en")

  documentos   DocumentoSolicitud[]
  historial    HistorialEstadoSolicitud[]
  asignaciones AsignacionEvaluacion[]
  dictamenes   Dictamen[]

  // US-015 lista por estudiante; US-012 busca la activa por estudiante y convocatoria.
  @@index([estudianteId, convocatoriaId])
  @@index([convocatoriaId, estado])
  @@map("solicitudes")
}

/// Un archivo por tipo de documento: reemplazar es actualizar la fila (US-013, criterio 3).
model DocumentoSolicitud {
  id            String    @id @default(uuid())
  solicitudId   String    @map("solicitud_id")
  solicitud     Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  tipo          String
  nombreArchivo String    @map("nombre_archivo")
  tipoContenido String    @map("tipo_contenido")
  tamanoBytes   Int       @map("tamano_bytes")
  // Dónde lo guardó el adaptador de almacenamiento. Nunca se expone al cliente.
  referencia    String
  cargadoEn     DateTime  @map("cargado_en")

  @@unique([solicitudId, tipo])
  @@map("documentos_solicitud")
}

/// US-016. Solo se insertan filas; la aplicación nunca las modifica ni las borra.
model HistorialEstadoSolicitud {
  id          String           @id
  solicitudId String           @map("solicitud_id")
  solicitud   Solicitud        @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  desde       EstadoSolicitud?
  hacia       EstadoSolicitud
  autorId     String           @map("autor_id")
  motivo      String?
  ocurridoEn  DateTime         @map("ocurrido_en")

  @@index([solicitudId, ocurridoEn])
  @@map("historial_estado_solicitud")
}

// ─── EPIC-04 · Evaluación y comités ────────────────────────────────────────────

/// US-017. Una convocatoria, un comité (índice único): CU-13, flujo 3a.
model Comite {
  id             String       @id
  nombre         String
  convocatoriaId String       @unique @map("convocatoria_id")
  convocatoria   Convocatoria @relation(fields: [convocatoriaId], references: [id], onDelete: Restrict)
  creadoPorId    String       @map("creado_por_id")
  creadoPor      Usuario      @relation("ComiteCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  creadoEn       DateTime     @map("creado_en")

  integrantes  ComiteEvaluador[]
  asignaciones AsignacionEvaluacion[]

  @@map("comites")
}

model ComiteEvaluador {
  comiteId    String   @map("comite_id")
  comite      Comite   @relation(fields: [comiteId], references: [id], onDelete: Cascade)
  evaluadorId String   @map("evaluador_id")
  evaluador   Usuario  @relation(fields: [evaluadorId], references: [id], onDelete: Restrict)
  agregadoEn  DateTime @default(now()) @map("agregado_en")

  @@id([comiteId, evaluadorId])
  @@map("comite_evaluadores")
}

/// US-018. Único por (solicitud, evaluador): asignar dos veces lo mismo no duplica.
model AsignacionEvaluacion {
  id            String    @id @default(uuid())
  comiteId      String    @map("comite_id")
  comite        Comite    @relation(fields: [comiteId], references: [id], onDelete: Restrict)
  solicitudId   String    @map("solicitud_id")
  solicitud     Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  evaluadorId   String    @map("evaluador_id")
  evaluador     Usuario   @relation("AsignacionEvaluador", fields: [evaluadorId], references: [id], onDelete: Restrict)
  asignadaPorId String    @map("asignada_por_id")
  asignadaPor   Usuario   @relation("AsignacionAutor", fields: [asignadaPorId], references: [id], onDelete: Restrict)
  asignadaEn    DateTime  @map("asignada_en")

  @@unique([solicitudId, evaluadorId])
  @@index([evaluadorId])
  @@index([comiteId])
  @@map("asignaciones_evaluacion")
}

enum Recomendacion {
  FAVORABLE
  DESFAVORABLE
}

/// US-019. Inmutable: la aplicación solo inserta. Uno por evaluador y solicitud.
model Dictamen {
  id            String        @id
  solicitudId   String        @map("solicitud_id")
  solicitud     Solicitud     @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  evaluadorId   String        @map("evaluador_id")
  evaluador     Usuario       @relation(fields: [evaluadorId], references: [id], onDelete: Restrict)
  // El nombre del criterio y el desglose se guardan tal como se calcularon: si la fórmula o el
  // perfil cambian después, el dictamen sigue explicando su propio puntaje.
  criterio      String
  puntaje       Decimal       @db.Decimal(5, 2)
  desglose      Json
  recomendacion Recomendacion
  observacion   String
  emitidoEn     DateTime      @map("emitido_en")

  @@unique([solicitudId, evaluadorId])
  @@index([evaluadorId])
  @@map("dictamenes")
}
